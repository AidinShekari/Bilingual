% ---------- sequence diagrams (message sequence charts) ----------------
% Usage inside tikzpicture:
%   \SeqActors[spacing]{UE,eNB,MME,HSS}
%   \SeqMsg[cp]{0}{2}{Attach Request}     (from actor 0 to actor 2)
%   \SeqMsg[up]{...}  \SeqSelf{1}{text}  \SeqNote{0}{3}{text}  \SeqGap
%   \SeqEnd
\newcounter{seqrow}
\newcommand\seqsp{2.6}
\newcommand\seqstep{0.62}
\newcommand\seqlast{0}
\tikzset{
  seqactor/.style={draw=acnnavy,fill=acnsky,rounded corners=2pt,
    minimum width=1.55cm,minimum height=0.62cm,
    font=\ACNheadfont\scriptsize\bfseries,text=acnnavy,align=center},
  seqmsg/.style={->,line width=0.75pt},
  seqlabel/.style={font=\ACNheadfont\scriptsize,above=-1.2pt,inner sep=1.5pt,
    text=black},
}
\NewDocumentCommand\SeqActors{O{2.6} m}{%
  \renewcommand\seqsp{#1}\setcounter{seqrow}{0}%
  \foreach \nm [count=\i from 0] in {#2}{%
    \node[seqactor] (act\i) at (\i*\seqsp,0) {\nm};
    \xdef\seqlast{\i}}}
\newcommand\seqy{-0.25-\seqstep*\value{seqrow}}
\NewDocumentCommand\SeqMsg{O{cp} m m m}{%
  \stepcounter{seqrow}%
  \pgfmathsetmacro\yy{-0.35-\seqstep*\value{seqrow}}%
  \draw[seqmsg,#1] (#2*\seqsp,\yy) -- node[seqlabel]{#4} (#3*\seqsp,\yy);}
\NewDocumentCommand\SeqSelf{m m}{%
  \stepcounter{seqrow}%
  \pgfmathsetmacro\yy{-0.35-\seqstep*\value{seqrow}}%
  \node[draw=acngray,fill=white,rounded corners=1pt,inner sep=2pt,
    font=\ACNheadfont\scriptsize,text=acngray] at (#1*\seqsp,\yy) {#2};}
\NewDocumentCommand\SeqNote{m m m}{%
  \stepcounter{seqrow}%
  \pgfmathsetmacro\yy{-0.35-\seqstep*\value{seqrow}}%
  \node[fill=acnmint,draw=acnteal,rounded corners=2pt,inner sep=2.5pt,
    font=\ACNheadfont\scriptsize\bfseries,text=acnnavy,
    minimum width={(#2-#1)*\seqsp*1cm+1.4cm}] at ({(#1+#2)/2*\seqsp},\yy) {#3};}
\NewDocumentCommand\SeqGap{}{\stepcounter{seqrow}}
\NewDocumentCommand\SeqEnd{}{%
  \stepcounter{seqrow}%
  \pgfmathsetmacro\yy{-0.35-\seqstep*\value{seqrow}}%
  \begin{scope}[on background layer]
  \foreach \i in {0,...,\seqlast}{%
    \draw[acnline,line width=0.9pt] (act\i.south) -- (\i*\seqsp,\yy);}
  \end{scope}}

