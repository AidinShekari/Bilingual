% =====================================================================
%  Advanced Communication Networks -- shared lecture style
%  Language-independent part. Loaded by templates/lecture-en.tex and
%  templates/lecture-fa.tex BEFORE any language-specific package
%  (xepersian/bidi must be the last package loaded in Persian files).
%  Engine: XeLaTeX.  Bibliography: biblatex + biber.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}

% ---------- page geometry ----------------------------------------------
\RequirePackage[a4paper,top=2.5cm,bottom=2.4cm,inner=2.3cm,outer=2.3cm,
  headheight=16pt,headsep=0.8cm,footskip=1.1cm]{geometry}

% ---------- mathematics (mathpazo matches TeX Gyre Pagella text) -----
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage[sc]{mathpazo}
\RequirePackage[no-math]{fontspec}
\RequirePackage{siunitx}
\sisetup{
  per-mode = symbol,
  inter-unit-product = \ensuremath{{}\cdot{}},
  exponent-product = \times,
  range-phrase = {\text{--}},
  list-final-separator = {, },
  list-pair-separator = {, },
  detect-weight = true,
}
\DeclareSIUnit\bit{bit}
\DeclareSIUnit\byte{B}
\DeclareSIUnit\dBm{dBm}
\DeclareSIUnit\dBi{dBi}
\DeclareSIUnit\dB{dB}
\DeclareSIUnit\erlang{E}
\DeclareSIUnit\symbol{sym}
\DeclareSIUnit\bps{bit/s}

